# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# Eventos ignorados (grupo, status, fromMe), duplicatas descartadas e a ordem
# de execução da fila são registrados em debug. Suba para investigar por que
# uma conversa se comportou de determinada forma.
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────
# Qualquer Postgres via connection string (sem SDK — claude.md §2).
#
# Opção A — Postgres do docker-compose (default para quem clona):
#   Deixe DATABASE_URL sem definir: rodando via `docker compose up`, o app
#   usa o serviço interno `db` automaticamente. Para `npm run dev` fora do
#   container contra esse banco, use:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/attendant
#
# Opção B — Supabase:
#   Use o SESSION POOLER (porta 5432) — o host direto db.<ref>.supabase.co
#   só resolve IPv6. `sslmode=no-verify` mantém TLS sem verificação de CA
#   (a cadeia do pooler usa CA própria do Supabase).
#   DATABASE_URL=postgres://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres?sslmode=no-verify
#   (substitua os três valores; não deixe colchetes ou sinais de menor/maior
#   ao redor da senha — eles viram parte dela e o login falha com 28P01.
#   Senha com @ : / ? # precisa de percent-encoding.)
#   Atenção: o free tier do Supabase pausa projetos após ~7 dias sem uso.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/attendant

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────
# Obrigatórias: sem elas o app se recusa a subir.
#
# URL da rede interna (backend e Evolution no mesmo servidor — claude.md §4),
# nunca pública, e sem barra no final. Qual usar depende de onde o app roda:
#   app no compose + Evolution no compose .... http://evolution:8080
#   app no host    + Evolution no host ....... http://localhost:8081
#   app no compose + Evolution no host ....... http://host.docker.internal:8081
EVOLUTION_BASE_URL=http://evolution:8080
EVOLUTION_API_KEY=
# O NOME da instância, não o id. A API monta a rota como
# /message/sendText/{nome}; passar o UUID devolve 404.
# Descubra com: curl -H "apikey: SUA_CHAVE" URL_BASE/instance/fetchInstances
EVOLUTION_INSTANCE=
#
# O webhook da instância precisa apontar para /webhook/whatsapp e assinar
# MESSAGES_UPSERT e PRESENCE_UPDATE, com webhookByEvents = false (com true a
# Evolution anexa o nome do evento à URL e a rota devolve 404):
#   curl -X POST -H "apikey: SUA_CHAVE" -H 'Content-Type: application/json' \
#     -d '{"webhook":{"enabled":true,"url":"http://app:3000/webhook/whatsapp",
#          "byEvents":false,"events":["MESSAGES_UPSERT","PRESENCE_UPDATE"]}}' \
#     URL_BASE/webhook/set/NOME_DA_INSTANCIA

# ── Comportamento da conversa ─────────────────────────────────────────────
# Mensagens de uma mesma pessoa são agrupadas em um bloco: a janela reinicia a
# cada mensagem nova e o teto garante resposta a quem não para de digitar.
# Janelas longas (30s+) passam impressão de bot morto — claude.md §7.
DEBOUNCE_SECONDS=10
DEBOUNCE_MAX_SECONDS=45
# Conversa parada por este tempo é encerrada e o contexto parcial descartado,
# para ninguém retomar dias depois dentro de uma coleta velha.
CONVERSATION_TIMEOUT_HOURS=24

# ── Colaboradores ─────────────────────────────────────────────────────────
# Aplicado aos telefones do CSV que vierem sem código de país. O comprimento
# decide: 10-11 dígitos é número nacional e recebe o DDI; 12+ já o traz.
# (Decidir pelo prefixo confundiria o DDD 55 com o país +55.)
DEFAULT_COUNTRY_CODE=55
#
# Carga inicial da base:
#   npm run import:employees -- caminho/para/colaboradores.csv
# Colunas: phone,name,department,email (email opcional).
# Reimportar o mesmo arquivo atualiza em vez de duplicar, e promove para 'csv'
# quem o bot havia cadastrado sozinho.

# ── IA ────────────────────────────────────────────────────────────────────
# Chave do Google AI Studio: https://aistudio.google.com/apikey
# Só 'gemini' está implementado; 'claude' fica reservado para quando o
# provedor da Anthropic existir (o boot falha claro se escolhido antes disso).
AI_PROVIDER=gemini
AI_API_KEY=
#
# gemini-3.8-flash tem tokens gratuitos no free tier do AI Studio e é o padrão.
# Com volume alto, gemini-3.1-flash-lite custa bem menos (US$ 0,25/US$ 1,50 por
# milhão contra US$ 0,75/US$ 3,75) e costuma bastar: triagem é classificação em
# quatro opções. Os modelos Pro perderam o free tier em abril de 2026.
# Atenção: os Flash mais novos podem devolver 503 por alta demanda. Se isso
# acontecer, gemini-3.1-flash-lite costuma responder e ainda é mais barato.
AI_MODEL=gemini-3.1-flash-lite
